{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WCB Discord Bot environment",
  "type": "object",
  "required": [
    "DISCORD_TOKEN",
    "OPENAI_API_KEY",
    "TRELLO_KEY",
    "TRELLO_TOKEN",
    "TRELLO_FEATURE_REQUEST_LIST"
  ],
  "properties": {
    "DISCORD_TOKEN": {"type": "string", "minLength": 1, "x-secret": true},
    "OPENAI_API_KEY": {"type": "string", "minLength": 1, "x-secret": true},
    "OPENAI_MODEL": {"type": "string", "default": "gpt-4.1-mini"},
    "OPENAI_TIMEOUT_SECONDS": {"type": "number", "exclusiveMinimum": 0, "default": 60},
    "TRELLO_KEY": {"type": "string", "minLength": 1, "x-secret": true},
    "TRELLO_TOKEN": {"type": "string", "minLength": 1, "x-secret": true},
    "TRELLO_BOARD": {"type": "string"},
    "TRELLO_FEATURE_REQUEST_LIST": {"type": "string", "minLength": 1},
    "TRUBOT_AUTO_MIN_INTERVAL_HOURS": {"type": "number", "minimum": 0, "default": 2},
    "TRUBOT_AUTO_DAILY_LIMIT": {"type": "integer", "minimum": 0, "default": 3},
    "LOG_LEVEL": {"type": "string", "default": "INFO"}
  },
  "additionalProperties": true
}
