{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trubot runtime environment",
  "type": "object",
  "required": ["DISCORD_TOKEN", "OPENAI_API_KEY"],
  "properties": {
    "DISCORD_TOKEN": {"type": "string", "minLength": 1, "x-secret": true},
    "OPENAI_API_KEY": {"type": "string", "minLength": 1, "x-secret": true},
    "TRUBOT_OPENAI_MODEL": {"type": "string", "minLength": 1, "default": "gpt-5.6-luna"},
    "OPENAI_TIMEOUT_SECONDS": {"type": "number", "exclusiveMinimum": 0, "default": 45},
    "OPENAI_MAX_RETRIES": {"type": "integer", "minimum": 0, "default": 2},
    "OPENAI_MAX_OUTPUT_TOKENS": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096,
      "default": 180
    },
    "TRUBOT_ALLOWED_CHANNEL_IDS": {
      "type": "string",
      "minLength": 1,
      "default": "1042804140490883084,1042804380354752592,1043023451482505229,1171482001275093112"
    },
    "TRUBOT_REACTION_EMOJIS": {"type": "string", "minLength": 1, "default": "ThomasJones,🍆"},
    "TRUBOT_HISTORY_LIMIT": {"type": "integer", "minimum": 1, "maximum": 100, "default": 30},
    "TRUBOT_HISTORY_WINDOW_MINUTES": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 360
    },
    "TRUBOT_FOLLOWUP_WINDOW_MINUTES": {
      "type": "number",
      "minimum": 0,
      "default": 10
    },
    "TRUBOT_AUTO_DELAY_MINUTES": {"type": "number", "minimum": 0, "default": 10},
    "TRUBOT_AUTO_ACTIVITY_WINDOW_MINUTES": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 60
    },
    "TRUBOT_AUTO_MIN_INTERVAL_HOURS": {"type": "number", "minimum": 0, "default": 2},
    "TRUBOT_AUTO_DAILY_LIMIT": {"type": "integer", "minimum": 0, "default": 3},
    "TRUBOT_AUTO_MIN_PARTICIPANTS": {"type": "integer", "minimum": 2, "default": 2},
    "HEALTH_READY_FILE": {"type": "string", "minLength": 1, "default": "/tmp/wcb-bot-ready"},
    "HEALTH_REFRESH_SECONDS": {"type": "number", "exclusiveMinimum": 0, "default": 60},
    "HEALTH_MAX_AGE_SECONDS": {"type": "number", "exclusiveMinimum": 0, "default": 180},
    "LOG_LEVEL": {"type": "string", "minLength": 1, "default": "INFO"}
  },
  "additionalProperties": true
}
